PROJECT_NAME="Smart Enroll Backend"
ENV="development"
ENABLE_DEV_SEED=false
API_V1_STR="/api/v1"
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="smartenroll"
SECRET_KEY="your-secure-random-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration (Increment 15, Task 15.3)
LLM_PROVIDER="disabled"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_API_BASE="https://api.openai.com/v1"
LLM_TIMEOUT_SECONDS=15.0
LLM_TEMPERATURE=0.0
LLM_FALLBACK_TO_DETERMINISTIC=true
LLM_ALLOW_LOCAL_ENDPOINTS=false
ORCHESTRATION_MAX_SECONDS=120.0

# API Hardening & Security (Hardening Phase 4)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
RATE_LIMIT_ENABLED=true
MAX_CONCURRENT_OCR_WORKERS=4

# Data Retention & Upload Security (Hardening Requirement M5)
# Days before abandoned draft applications and unlinked files are purged
RETENTION_DAYS=30
# Upload malware scanner ("noop" or "clamav")
UPLOAD_SCANNER=noop
